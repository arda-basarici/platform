# Nearly everything here is consumed on a Linux host (shell scripts, systemd units,
# Caddy config, Terraform, Ansible) — a CRLF checkout on the Windows workstation
# would ship "\r" to the box. Pin LF for those; let git normalize the rest.
* text=auto
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.caddy         text eol=lf
Caddyfile       text eol=lf
*.tf            text eol=lf
*.tftpl         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.j2            text eol=lf
.githooks/*     text eol=lf
